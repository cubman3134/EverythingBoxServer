<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EverythingBox.Server.Abstractions\EverythingBox.Server.Abstractions.csproj" />
    <ProjectReference Include="..\EverythingBox.Server\EverythingBox.Server.csproj" />
  </ItemGroup>

  <!-- Build the fixtures but do NOT reference their assemblies — they must be
       discovered from disk exactly as a real plugin is. -->
  <ItemGroup>
    <ProjectReference Include="..\tests\TestPlugin.Good\TestPlugin.Good.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\tests\TestPlugin.Bad\TestPlugin.Bad.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\tests\TestPlugin.Dup\TestPlugin.Dup.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Stage each fixture's FULL build output directory, not just its named DLL. A
       regression that makes a fixture privately copy Abstractions.dll (e.g. flipping
       Private="true") must actually land next to the plugin here — copying only the
       one named DLL would silently hide that hazard from the tests. -->
  <Target Name="StageTestPlugins" AfterTargets="Build">
    <ItemGroup>
      <GoodPluginOut Include="..\tests\TestPlugin.Good\bin\$(Configuration)\net9.0\**\*.*" />
      <BadPluginOut Include="..\tests\TestPlugin.Bad\bin\$(Configuration)\net9.0\**\*.*" />
      <DupPluginOut Include="..\tests\TestPlugin.Dup\bin\$(Configuration)\net9.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(GoodPluginOut)" DestinationFolder="$(OutDir)testplugins\good\%(RecursiveDir)" />
    <Copy SourceFiles="@(BadPluginOut)" DestinationFolder="$(OutDir)testplugins\bad\%(RecursiveDir)" />
    <Copy SourceFiles="@(DupPluginOut)" DestinationFolder="$(OutDir)testplugins\dup\%(RecursiveDir)" />
  </Target>

</Project>
