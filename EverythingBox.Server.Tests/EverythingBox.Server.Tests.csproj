<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- MusicScannerTests synthesize tagged audio fixtures at runtime with ATL. -->
    <PackageReference Include="z440.atl.core" Version="6.26.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- GrabberFactoryTests asserts directly on TorrentGrabber (grabber.Providers /
         grabber.Options), which lives in Core; add the using globally rather than
         editing that test file's imports, which the task brief specifies verbatim. -->
    <Using Include="EverythingBox.Server.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EverythingBox.Server.Abstractions\EverythingBox.Server.Abstractions.csproj" />
    <ProjectReference Include="..\EverythingBox.Server\EverythingBox.Server.csproj" />
  </ItemGroup>

  <!-- Build the fixtures but do NOT reference their assemblies — they must be
       discovered from disk exactly as a real plugin is. -->
  <ItemGroup>
    <ProjectReference Include="..\tests\TestPlugin.Good\TestPlugin.Good.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\tests\TestPlugin.Bad\TestPlugin.Bad.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\tests\TestPlugin.Dup\TestPlugin.Dup.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\tests\TestPlugin.Throwing\TestPlugin.Throwing.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\tests\TestPlugin.Metadata\TestPlugin.Metadata.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\EverythingBox.Server.SampleSource\EverythingBox.Server.SampleSource.csproj" />
    <ProjectReference Include="..\EverythingBox.Server.LocalLibrary\EverythingBox.Server.LocalLibrary.csproj" />
    <ProjectReference Include="..\EverythingBox.Server.RomLibrary\EverythingBox.Server.RomLibrary.csproj" />
    <ProjectReference Include="..\EverythingBox.Server.MusicLibrary\EverythingBox.Server.MusicLibrary.csproj" />
  </ItemGroup>

  <!-- Stage each fixture's FULL build output directory, not just its named DLL. A
       regression that makes a fixture privately copy Abstractions.dll (e.g. flipping
       Private="true") must actually land next to the plugin here — copying only the
       one named DLL would silently hide that hazard from the tests. -->
  <Target Name="StageTestPlugins" AfterTargets="Build">
    <ItemGroup>
      <GoodPluginOut Include="..\tests\TestPlugin.Good\bin\$(Configuration)\net9.0\**\*.*" />
      <BadPluginOut Include="..\tests\TestPlugin.Bad\bin\$(Configuration)\net9.0\**\*.*" />
      <DupPluginOut Include="..\tests\TestPlugin.Dup\bin\$(Configuration)\net9.0\**\*.*" />
      <ThrowingPluginOut Include="..\tests\TestPlugin.Throwing\bin\$(Configuration)\net9.0\**\*.*" />
      <MetadataPluginOut Include="..\tests\TestPlugin.Metadata\bin\$(Configuration)\net9.0\**\*.*" />
      <!-- The real music-library plugin, staged as a plugin folder (with ATL.dll + .deps.json) so
           SubsonicServerFactory can load it from disk and register an IMusicLibrary in DI. -->
      <MusicPluginOut Include="..\EverythingBox.Server.MusicLibrary\bin\$(Configuration)\net9.0\**\*.*" />
    </ItemGroup>
    <!-- Fail the BUILD, loudly and by name, if a fixture produced nothing to stage.
         A ProjectReference alone is not enough: a plugin project missing from the
         .sln is not built by a solution-level `dotnet build`, so its bin/ is empty
         on a clean checkout. That shipped once — the wildcards matched nothing, the
         Copy silently did nothing, and the first sign was a DirectoryNotFoundException
         from a dozen unrelated tests in CI while every local run was green (a stale
         bin/Debug from an earlier ad-hoc build was covering it). Add a new fixture to
         the .sln as well as to the ProjectReference list above. -->
    <Error Condition="'@(GoodPluginOut)' == ''" Text="TestPlugin.Good produced no output to stage. Is it in EverythingBoxServer.sln?" />
    <Error Condition="'@(BadPluginOut)' == ''" Text="TestPlugin.Bad produced no output to stage. Is it in EverythingBoxServer.sln?" />
    <Error Condition="'@(DupPluginOut)' == ''" Text="TestPlugin.Dup produced no output to stage. Is it in EverythingBoxServer.sln?" />
    <Error Condition="'@(ThrowingPluginOut)' == ''" Text="TestPlugin.Throwing produced no output to stage. Is it in EverythingBoxServer.sln?" />
    <Error Condition="'@(MetadataPluginOut)' == ''" Text="TestPlugin.Metadata produced no output to stage. Is it in EverythingBoxServer.sln?" />
    <Error Condition="'@(MusicPluginOut)' == ''" Text="EverythingBox.Server.MusicLibrary produced no output to stage. Is it in EverythingBoxServer.sln?" />

    <Copy SourceFiles="@(GoodPluginOut)" DestinationFolder="$(OutDir)testplugins\good\%(RecursiveDir)" />
    <Copy SourceFiles="@(BadPluginOut)" DestinationFolder="$(OutDir)testplugins\bad\%(RecursiveDir)" />
    <Copy SourceFiles="@(DupPluginOut)" DestinationFolder="$(OutDir)testplugins\dup\%(RecursiveDir)" />
    <Copy SourceFiles="@(ThrowingPluginOut)" DestinationFolder="$(OutDir)testplugins\throwing\%(RecursiveDir)" />
    <Copy SourceFiles="@(MetadataPluginOut)" DestinationFolder="$(OutDir)testplugins\browsemeta\%(RecursiveDir)" />
    <Copy SourceFiles="@(MusicPluginOut)" DestinationFolder="$(OutDir)testplugins\musiclib\%(RecursiveDir)" />
  </Target>

</Project>
