{
  "Listen": "http://0.0.0.0:7000",
  "AccessToken": null,
  "PluginsDirectory": null,
  "FilesCacheDir": null,
  "Manifest": {
    "Id": "com.everythingbox.server",
    "Name": "EverythingBox Server",
    "Version": "1.0.0",
    "Description": "Media from the sources you configure.",
    "Accent": "#3E8E7E"
  },
  "Plugins": {},

  // Torznab endpoints (e.g. Prowlarr, Jackett). Empty by default — this server ships no indexer.
  "Indexers": [],
  // "Indexers": [
  //   { "Name": "prowlarr", "BaseUrl": "http://localhost:9696/1/api", "ApiKey": "" }
  // ],

  // Optional. Provider is "torbox" or "realdebrid". Leave ApiKey blank to disable.
  // WaitSeconds: how long to block waiting for an uncached release to finish caching on
  // the debrid before returning a still-caching notice. 0 (default) = don't wait — resolve
  // instantly if already cached, otherwise report pending right away.
  "Debrid": { "Provider": "", "ApiKey": "", "WaitSeconds": 0 },

  // Optional. Kind is "qbittorrent" or "transmission".
  "DownloadClient": { "Kind": "", "BaseUrl": "", "Username": "", "Password": "", "Category": "" },

  // Optional. Fetch an uncached release yourself instead of waiting on debrid.
  // OFF by default: this joins a BitTorrent swarm from YOUR IP address, which is a
  // different thing from asking a service you pay for to fetch something. Turn it on
  // only if that is what you want.
  "Download": { "Enabled": false, "MaxSizeMB": 2048, "TimeoutSeconds": 600 },

  "Ranking": { "MinSeeders": 1, "BannedTerms": [] },

  // Optional grabber tuning. Ships with engine-neutral defaults — an absent Grabber
  // section deserializes to these same values, so omitting it changes nothing about
  // existing behavior.
  // QuickGrabScore: early-exit search once a candidate scores at least this; null
  // (default) = search all providers and pick the overall best.
  // ProviderTimeoutSeconds: per-provider search timeout, in seconds. Default 30.
  // PreferCachedReleases: float debrid-cached releases to the front. Default false.
  "Grabber": { "QuickGrabScore": null, "ProviderTimeoutSeconds": 30, "PreferCachedReleases": false }
}
