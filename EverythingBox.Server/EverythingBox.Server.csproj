<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EverythingBox.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EverythingBox.Server.Abstractions\EverythingBox.Server.Abstractions.csproj" />
    <ProjectReference Include="..\EverythingBox.Server.Core\EverythingBox.Server.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="everythingbox-server.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EverythingBox.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-process BitTorrent, so an uncached release can be fetched directly rather
         than waiting on debrid. HOST ONLY: Core is BCL-only by design and two tests
         enforce that, which is exactly why ITorrentDownloader is an interface. -->
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
  </ItemGroup>

</Project>
