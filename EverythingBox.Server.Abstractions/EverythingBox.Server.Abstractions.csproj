<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EverythingBox.Server.Abstractions</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- The ONLY third-party dependency this assembly may ever take. Plugins
       reference it, so it has to stay cheap to load. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <!-- BoundedReadStream stays internal; the test project exercises it directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="EverythingBox.Server.Tests" />
  </ItemGroup>

</Project>
